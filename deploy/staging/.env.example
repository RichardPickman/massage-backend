# Copy to .env beside this file, fill it in, never commit it.
#
# Deliberately the same shape as ../.env.production.example: the point of this
# stack is to rehearse production. What differs is the data it owns - a second
# database, a second bucket, its own signing key - so that a reset here cannot
# reach the live one.

# --- compose ---------------------------------------------------------------
# The same hostname as production. Only the port differs, and a certificate is
# issued for a name, not for a port.
DOMAIN=asystastomatologiczna.site

# Image coordinates. WHAT IS RUNNING IS WRITTEN HERE: the deploy workflow sets
# these two to the commit it built, so a rollback is editing a line and not
# rebuilding anything.
REGISTRY=ghcr.io/richardpickman
WEB_TAG=latest
API_TAG=latest

# --- required by the app ---------------------------------------------------
# index.ts refuses to start if any of these are blank: that check is the reason a
# misconfigured box fails loudly instead of answering every request with a 500.
PORT=8280
HOST=0.0.0.0

# The same Atlas cluster, a second database. Atlas allows more than one, so this
# costs nothing extra; the machine has to be allowlisted in Network Access
# already, which it is because production runs here.
DB_USER=
DB_PASSWORD=
DB_HOST=
# Must contain "test": reset.sh refuses to drop a database whose name does not
# look like a testing one, which is the guard against pointing this file at
# production by mistake.
DB=testing

# Fresh, and different from production: a token minted here is not one the live
# API accepts, so a staging session cannot leak into the real app.
SECRET_KEY=

# --- registration gate -----------------------------------------------------
#   openssl rand -hex 32
INVITE_SECRET=
# Put your own address here so an account can be made on the staging origin
# without an invite code.
ADMIN_EMAILS=

# --- lecture images --------------------------------------------------------
# A second bucket. S3 keys cannot be scoped to a prefix, so a shared bucket would
# let this stack read and delete production's uploads.
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_REGION=
BUCKET_NAME=

# --- auth throttle ---------------------------------------------------------
# Looser than production on purpose: signing in over and over from the same IP is
# what testing a login flow looks like, and being locked out of one's own staging
# box is a waste of an afternoon.
AUTH_ATTEMPT_LIMIT=100
AUTH_ATTEMPT_WINDOW_MS=900000
