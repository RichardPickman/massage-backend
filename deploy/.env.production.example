# Copy to .env beside this file, fill it in, never commit it.
#
# Compose reads DOMAIN, REGISTRY and TAG from this file for interpolation, and
# passes the whole file to the api container as its environment. The names below
# are the ones config/index.ts reads; nothing here is optional unless marked.

# --- compose ---------------------------------------------------------------
# The hostname Caddy gets a certificate for. It must already resolve to this
# machine, or the challenge fails and Caddy retries every few minutes forever.
DOMAIN=

# Image coordinates. The deploy workflow overrides TAG with the commit it built.
REGISTRY=ghcr.io/richardpickman
TAG=latest

# --- required by the app ---------------------------------------------------
# index.ts refuses to start if any of these are blank: that check is the reason a
# misconfigured box fails loudly instead of answering every request with a 500.
PORT=8280
HOST=0.0.0.0

DB_USER=
DB_PASSWORD=
# The Atlas hostname only, e.g. cluster0.xxxxx.mongodb.net - no scheme, no
# credentials. The IP of this machine has to be allowed in Atlas Network Access
# first, otherwise the connection hangs and looks like a code bug.
DB_HOST=
DB=

# Signs every token. Rotating it signs everyone out.
SECRET_KEY=

# --- registration gate -----------------------------------------------------
# Leave INVITE_SECRET blank and only ADMIN_EMAILS can register, which is a valid
# deployment but a locked one. Set it before you expect other people to sign up.
#   openssl rand -hex 32
INVITE_SECRET=
# Comma-separated. These addresses skip the code and are admins, but only at the
# moment they register: an account that already exists keeps the role it got.
ADMIN_EMAILS=

# --- lecture images --------------------------------------------------------
# Optional to boot, required for anything that shows an image: uploads are handed
# to S3 and the frontend renders presigned URLs, so with these blank the app runs
# and every image request fails.
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_REGION=
BUCKET_NAME=

# --- auth throttle ---------------------------------------------------------
# Defaults are 10 attempts per 15 minutes per caller.
AUTH_ATTEMPT_LIMIT=10
AUTH_ATTEMPT_WINDOW_MS=900000
