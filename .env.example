# Copy to .env and fill in. config/index.ts loads this file through dotenv.
# Anything left blank here is a variable the app expects to exist.

# Database
DB_USER=
DB_PASSWORD=
DB_HOST=
DB=

# Server
PORT=5000
HOST=0.0.0.0

# Object storage (avatars)
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_REGION=
BUCKET_NAME=

# Token signing. Rotating this signs everyone out.
SECRET_KEY=

# Registration gate. See .scratch/signup-wall/README.md in the frontend repo.
# Without INVITE_SECRET nobody can register except the ADMIN_EMAILS addresses.
#   40 hex characters or so, e.g. openssl rand -hex 32
INVITE_SECRET=
# Comma-separated. These addresses register without a code and are admins.
ADMIN_EMAILS=

# Auth throttle. Defaults: 10 attempts per 15 minutes, per caller.
# AUTH_ATTEMPT_LIMIT=10
# AUTH_ATTEMPT_WINDOW_MS=900000

# Set to 1 only where nginx or another proxy fronts the app, so the limiter sees
# the real caller in X-Forwarded-For instead of the proxy's own address.
# TRUST_PROXY=1
